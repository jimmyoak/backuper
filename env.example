TZ=Europe/Madrid

# Cron schedule for backups (default: 3 AM daily)
BACKUP_CRON=0 3 * * *

# Absolute path on the host where backups are stored.
# Use a dedicated subdirectory of your partition — Docker only mounts this exact path,
# so nothing else on the partition is accessible or at risk.
BACKUP_LOCATION=/mnt/data/backups

# ── quierocambiarlo ──────────────────────────────────────────────────────────
QC_REMOTE_HOST=your-ovh-host-ip-or-hostname
QC_REMOTE_USER=debian
QC_REMOTE_BASE_PATH=/home/debian/quierocambiarlo
QC_DB_CONTAINER=quierocambiarlo-database-1
QC_DB_USER=basic
# Days to retain timestamped database dumps
QC_DB_RETENTION_DAYS=30
# Days to retain deleted/overwritten files in the uploads archive
QC_UPLOADS_RETENTION_DAYS=30
